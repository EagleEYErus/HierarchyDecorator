/* Hierarchy Decorator 2 - Project Settings / Preferences page. */

.hd-settings-root {
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 12px;
}

.hd-section {
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.hd-heading {
    -unity-font-style: bold;
    font-size: 13px;
    margin-top: 6px;
    margin-bottom: 2px;
}

.hd-subheading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 2px;
}

.hd-hint {
    white-space: normal;
    color: var(--unity-colors-label-text);
    opacity: 0.7;
    margin-bottom: 6px;
}

.hd-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.hd-row > * {
    margin-right: 4px;
}

.hd-grow {
    flex-grow: 1;
}

.hd-component-rules {
    margin-top: 4px;
}

.hd-component-rule-list {
    margin-top: 4px;
    margin-bottom: 4px;
}

.hd-rule-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.hd-rule-name {
    width: 220px;
    flex-shrink: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hd-rule-assembly {
    flex-grow: 1;
    opacity: 0.55;
    overflow: hidden;
    text-overflow: ellipsis;
}

.hd-rule-display {
    width: 110px;
    flex-shrink: 0;
    margin-bottom: 0;
}
