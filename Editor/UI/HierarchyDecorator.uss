/*
 * Hierarchy Decorator 2 - structural rules.
 *
 * Everything is scoped under .hd-root, which is added to HierarchyView.StyleContainer. The built-in
 * .hierarchy-item__* rules live in the editor-wide DefaultCommon stylesheets and HierarchyView is reused by
 * other windows, so unscoped selectors would leak far outside the Hierarchy.
 *
 * Colours come from the paired _dark / _light sheets as --hd-* variables. The editor has no theme selector,
 * so this mirrors what Unity's own HierarchyWindow.uss does.
 */

/* ---------------------------------------------------------------- tree guide lines */

.hd-root .hd-tree-lines {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

/* ---------------------------------------------------------------- headers */

/* The header text is our own Label, not Unity's. Unity's inline rename reads its name Label to seed the edit
   field, so writing the stripped text there destroyed the prefix on rename. */

.hd-root .hd-header-label {
    overflow: hidden;
    text-overflow: ellipsis;
    padding-left: 2px;
    padding-right: 2px;
}

/* ---------------------------------------------------------------- component icons */

/* Layout for the icon elements themselves is set inline (see IconElements) so that a stylesheet that
   fails to load cannot turn every icon into an invisible zero-sized box. Only cosmetics live here. */

.hd-root .hd-component-icons {
    margin-right: 2px;
}

.hd-root .hd-component-icon {
    margin-left: 1px;
    background-position: center;
}

/* A backing plate, not a tint. -unity-background-image-tint-color MULTIPLIES the image: white left the dark
   theme with no hover feedback at all, and the light theme's dark value turned the icon almost black. */
.hd-root .hd-component-icon:hover {
    background-color: var(--hd-icon-hover-background);
    border-radius: 2px;
}

.hd-root .hd-icon-count {
    position: absolute;
    right: -2px;
    bottom: -3px;
    font-size: 8px;
    -unity-font-style: bold;
    color: var(--hd-badge-text);
    background-color: var(--hd-badge-background);
    border-radius: 4px;
    padding-left: 2px;
    padding-right: 2px;
}

.hd-root .hd-icon-overflow {
    font-size: 9px;
    -unity-font-style: bold;
    margin-left: 3px;
    margin-right: 1px;
    color: var(--hd-overflow-text);
}

/* ---------------------------------------------------------------- columns */

.hd-root .hd-children-count {
    flex-grow: 1;
    -unity-text-align: middle-right;
    padding-right: 4px;
    opacity: 0.75;
}

/* ---------------------------------------------------------------- indicators */

.hd-root .hd-indicator {
    margin-left: 3px;
    background-position: center;
}
